# Functions and aliases shared by bash and zsh.

# Simple QOL "aliases".
unalias cat cp diff lack ls mv rm vim 2>/dev/null || :

[[ -n $CLAUDECODE ]] || cat() { command cat -v "$@"; }
cp() { command cp -i "$@"; }
diff() { command diff -u "$@"; }
lack() { command ack --pager="less -R" "$@"; }
mv() { command mv -i "$@"; }
rm() { command rm -I "$@"; }
vim() { command vim -p "$@"; }

# GNU and BSD ls spell "colorize" differently, and BSD getopt chokes on the
# long option rather than ignoring it. Probe once here instead of every call.
if command ls --color=auto /dev/null >/dev/null 2>&1; then
    ls() { command ls --color=auto -F "$@"; }
else
    ls() { command ls -G -F "$@"; }
fi

export EDITOR=vim
export LESS=' -R -P?f%f - .?ltLine?lbs. %lt?lb-%lb.?L of %L.?PB - %PB\%.:?pb%pb\%:?btByte %bt?pB - %pB\%.:-...?e (END).'
export PYTHONSTARTUP=~/.pythonrc.py
export VISUAL=vim

# Build with all but two cores, so a big build leaves the machine usable.
# getconf is portable where nproc isn't.
_ncpus=$(getconf _NPROCESSORS_ONLN)
export MAKEFLAGS=-j$(( _ncpus > 2 ? _ncpus - 2 : 1 ))
unset _ncpus

# Add a `dotfiles` alias for working with the `.dotfiles` repo.
dotfiles() {
    git --git-dir="$HOME"/.dotfiles --work-tree="$HOME" "$@"
}

# Search with ripgrep and page the results. rg reads stdin when it's a pipe, so
# this works at the tail of a pipeline as well as against a file.
rgl() {
    rg -p "$@" | less -R
}

# Like rgl, but pages a crossword wordlist's matches shortest entry first.
# Entries are `word;score` lines, and "shortest" counts the squares an entry
# fills, not the characters it's spelled with: `'Allo 'Allo;51` is an 8, not
# a 12.
rgll() {
    local pattern=$1
    shift

    # Highlight in the same pass that matches, rather than re-grepping the
    # sorted output to colorize it: that way `^nose` only ever meets the
    # wordlist line, never one with a length column stuck on the front. The
    # cost is that the escapes have to come back out before measuring.
    rg --color=always "$pattern" "$@" |
        awk -v esc=$'\033' -v OFS='\t' '{
            sub(/\r$/, "")                       # some lists are CRLF

            entry = $0
            gsub(esc "\\[[0-9;]*m", "", entry)   # the highlighting
            sub(/;.*/, "", entry)                # the score
            gsub(/[^a-zA-Z0-9]/, "", entry)      # spaces and punctuation
            print length(entry), entry, $0
        }' |
        # Sorting on the bare entry too breaks length ties alphabetically,
        # rather than by wherever the highlight happened to land.
        sort -t$'\t' -k1,1n -k2,2 |
        awk -F'\t' '{ printf "%2d  %s\n", $1, $3 }' |
        less -R
}

# tree's `ioctl(1, TCGETS, ...)` call fails for some reason despite stdout
# being connected to a TTY.
tree() {
    if [[ -t 1 ]]; then
        command tree -ACF "$@"
    else
        command tree "$@"
    fi
}

# Add cargo to path if Rust is installed.
if [[ -e $HOME/.cargo/env ]]; then
    . "$HOME/.cargo/env"
fi

# Load nvm, the version manager for node.js, if it's installed.
if [[ -d ~/.nvm ]]; then
    export NVM_DIR="$HOME/.nvm"
    . "$NVM_DIR/nvm.sh"
fi

# Load worktrunk's shell integration if it's installed. The emitted script
# genuinely differs per shell (bash `complete` vs zsh `compdef`/`zstyle`), so
# the shell name has to be passed through. The outer guard keeps `wt config`
# from erroring out when wt isn't installed at all.
if command -v wt >/dev/null 2>&1; then
    if [[ -n $ZSH_VERSION ]]; then
        eval "$(command wt config shell init zsh)"
    else
        eval "$(command wt config shell init bash)"
    fi
fi

# Source local customizations.
[[ ! -f ~/.config/local.shrc ]] || source ~/.config/local.shrc

# vim: syntax=sh
