{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "0.25"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node ~/.claude/scripts/check-syntax.js:*)"
    ],
    "deny": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "~/.claude"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/dotfiles-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "auto",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
